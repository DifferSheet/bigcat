{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AlbumBucket",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::bigcathouse-media", "arn:aws:s3:::bigcathouse-media/*"]
    },
    {
      "Sid": "FaceCollection",
      "Effect": "Allow",
      "Action": [
        "rekognition:CreateCollection", "rekognition:ListCollections", "rekognition:DescribeCollection",
        "rekognition:IndexFaces", "rekognition:SearchFaces", "rekognition:SearchFacesByImage",
        "rekognition:ListFaces", "rekognition:DeleteFaces", "rekognition:DetectFaces"
      ],
      "Resource": "*"
    }
  ]
}

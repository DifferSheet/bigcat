# MySQL บนเครื่อง (Homebrew: brew services start mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bigcat

# API / Socket.IO
PORT=3001

# รหัสสำหรับหน้า /admin (ส่งเป็น header x-admin-key)
ADMIN_KEY=bigcat-admin

# ---- ตรวจสลิปอัตโนมัติ (none | mock | slipok | easyslip) ----
# mock = ผ่านทุกสลิปสำหรับทดสอบบนเครื่อง  · slipok ฟรี 100 สลิป/เดือน (ต้องมี branch id)
SLIP_PROVIDER=mock
SLIP_API_KEY=
SLIP_BRANCH_ID=
# ชื่อบัญชีผู้รับที่ยอมรับ คั่นด้วย | (ตรวจแบบมีส่วนของชื่อ) เว้นว่าง = ไม่ตรวจชื่อ
SLIP_RECEIVER_NAME=
SLIP_MAX_AGE_DAYS=7

# ---- LINE Messaging API (LINE Official Account → Messaging API) ----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_OA_ID=@your-oa-id
# userId/groupId ของทีมงานสำหรับรับแจ้งเตือนรายการใหม่ (ดูจาก webhook log)
LINE_STAFF_TARGET=

# URL เว็บ (ใช้ในลิงก์ที่ส่งทาง LINE)
# URL ของเว็บ (ใช้ใน metadata/OG/sitemap และลิงก์ที่ส่งทาง LINE)
SITE_URL=http://localhost:3100
# Express API ที่ Next จะ rewrite ไปหา
API_ORIGIN=http://localhost:3001
# origin ที่ browser ใช้ต่อ Socket.IO (ต้อง NEXT_PUBLIC_ เพื่อส่งถึง client)
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001
# พอร์ตของ Next (เปลี่ยนได้ถ้าชนกับโปรเจกต์อื่น)
WEB_PORT=3100

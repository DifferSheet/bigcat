# MySQL บนเครื่อง (Homebrew: brew services start mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bigcat

# API / Socket.IO
PORT=3001

# รหัสสำหรับหน้า /admin (ส่งเป็น header x-admin-key)
# แอดมินเข้าสู่ระบบด้วยชื่อผู้ใช้/รหัสผ่านที่ /admin — บัญชีแรก `admin` ถูกสร้างอัตโนมัติด้วยรหัสผ่าน = ADMIN_KEY (เปลี่ยนในหน้าจัดการได้)
# ค่านี้ยังใช้เป็น x-admin-key สำหรับสคริปต์/จอสุ่ม
ADMIN_KEY=bigcat-admin

# ---- ตรวจสลิปอัตโนมัติ (none | mock | slipok | easyslip) ----
# mock = ผ่านทุกสลิปสำหรับทดสอบบนเครื่อง  · slipok ฟรี 100 สลิป/เดือน (ต้องมี branch id)
# none | mock | slipok | easyslip | thunder (https://thunder.in.th — key จาก developer.thunder.in.th ใส่ SLIP_API_KEY)
SLIP_PROVIDER=mock
SLIP_API_KEY=
SLIP_BRANCH_ID=
# ชื่อบัญชีผู้รับที่ยอมรับ คั่นด้วย | (ตรวจแบบมีส่วนของชื่อ) เว้นว่าง = ไม่ตรวจชื่อ
SLIP_RECEIVER_NAME=
SLIP_MAX_AGE_DAYS=7

# ---- LINE Messaging API (LINE Official Account → Messaging API) ----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_OA_ID=@your-oa-id
# userId/groupId ของทีมงานสำหรับรับแจ้งเตือนรายการใหม่ (ดูจาก webhook log)
LINE_STAFF_TARGET=

# URL เว็บ (ใช้ในลิงก์ที่ส่งทาง LINE)
# URL ของเว็บ (ใช้ใน metadata/OG/sitemap และลิงก์ที่ส่งทาง LINE)
SITE_URL=http://localhost:3100
# Express API ที่ Next จะ rewrite ไปหา
API_ORIGIN=http://localhost:3001
# origin ที่ browser ใช้ต่อ Socket.IO (ต้อง NEXT_PUBLIC_ เพื่อส่งถึง client)
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001
# พอร์ตของ Next (เปลี่ยนได้ถ้าชนกับโปรเจกต์อื่น)
WEB_PORT=3100
# ตาข่ายชั้นสอง: ตรวจสลิปผ่านแล้วยังรอแอดมินกดยืนยัน (ไม่ตั้ง = ปิด auto-approve) · เปิดเมื่อมั่นใจ: SLIP_AUTO_APPROVE=true
SLIP_AUTO_APPROVE=

# ---- สมาชิก: เข้าสู่ระบบด้วย LINE / Google (ว่าง = ปิดช่องทางนั้น) ----
# LINE Login channel (คนละตัวกับ Messaging API) · Callback URL = {SITE_URL}/api/auth/line/callback
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# ถ้า LINE Login กับ OA อยู่ provider เดียวกันใน LINE Developers ให้ตั้ง true → ผูกแจ้งเตือน OA ให้อัตโนมัติไม่ต้องส่งรหัส 8 หลัก
LINE_LOGIN_SAME_PROVIDER=
# Google Cloud → APIs & Services → Credentials → OAuth client (Web) · Authorized redirect URI = {SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# อัลบั้มรูปงาน + ค้นหาใบหน้า (server/faces.js)
#   local        = face-api ในเครื่อง (ค่าเริ่มต้น ไม่มีค่าใช้จ่าย ข้อมูลไม่ออกนอกเครื่อง)
#   rekognition  = AWS Rekognition (ต้องมี AWS_REGION + AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY หรือ IAM role ของ EC2)
#   none         = ปิดการจับคู่ใบหน้า (อัลบั้มยังใช้ได้)
FACE_PROVIDER=local
# ที่เก็บรูปอัลบั้ม: เว้นว่าง = ดิสก์ของเครื่อง (server/uploads/albums) · ใส่ชื่อ bucket = เก็บบน S3 แล้วเสิร์ฟด้วยลิงก์ชั่วคราว
# MEDIA_BUCKET=bigcathouse-media
# MEDIA_URL_TTL=21600              # อายุลิงก์รูป (วินาที)
# FACE_MATCH_THRESHOLD=0.55        # local: 1 - ระยะ (สูง = เข้มงวด) · rekognition: 0.9 = 90%
# REKOGNITION_COLLECTION=bigcat-faces
# AWS_REGION=ap-southeast-1
